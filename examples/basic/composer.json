{
    "name": "crenspire/yii2-inertia-example",
    "description": "Example Yii2 application using Inertia.js",
    "type": "project",
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "~2.0.50",
        "crenspire/yii2-inertia": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../"
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

