{
    "name": "crenspire/yii2-inertia",
    "description": "Inertia.js adapter for Yii2 framework",
    "type": "library",
    "keywords": ["yii2", "inertia", "inertiajs", "spa", "adapter"],
    "license": "MIT",
    "authors": [
        {
            "name": "Crenspire",
            "email": "support@crenspire.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "~2.0.50",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "yiisoft/yii2-dev": "~2.0.50"
    },
    "autoload": {
        "psr-4": {
            "Crenspire\\Yii2Inertia\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Crenspire\\Yii2Inertia\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

