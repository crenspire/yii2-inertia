{
    "name": "crenspire/yii2-inertia-example",
    "description": "Example Yii2 application using Inertia.js v3, React and Vite",
    "type": "project",
    "require": {
        "php": "^8.1",
        "crenspire/yii2-inertia": "@dev",
        "yiisoft/yii2": "~2.0.55"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
