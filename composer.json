{
    "name": "crenspire/yii2-inertia",
    "description": "Inertia.js v3 adapter for the Yii2 framework",
    "type": "yii2-extension",
    "keywords": ["yii2", "inertia", "inertiajs", "spa", "adapter", "vite", "ssr"],
    "license": "MIT",
    "authors": [
        {
            "name": "Crenspire",
            "email": "support@crenspire.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "yiisoft/yii2": "~2.0.55"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Crenspire\\Yii2Inertia\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Crenspire\\Yii2Inertia\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "bootstrap": "Crenspire\\Yii2Inertia\\Bootstrap"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
